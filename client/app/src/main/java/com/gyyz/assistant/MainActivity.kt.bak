/** 鎼存梻鏁ゆ稉鑽ゅЦ閹�?*/
sealed class AppState {
    /** 閻ц�茬秿/濞夈劌鍞芥い鐢告桨 */
    data class Login(val isLoading: Boolean = false, val error: String = "") : AppState()

    /** 鐠虹喕閲滅�涳缚绡勫Ο鈥崇础 - 姒涙�款吇閻樿埖鈧�?*/
    object Tracking : AppState()

    /** 鐟欙綁顣藉Ο鈥崇础 */
    data class Solving(
            val stage: SolveStage = SolveStage.UPLOADING,
            val requestId: String = "",
            val questionInfo: String = "",
            val solutionSteps: String = "",
            val fullSolution: String = "",
            val mindMap: String = "",
            val suggestedQuestions: List<String> = emptyList()
    ) : AppState()

    /** 鐎涳附鍎忛幎銉ユ啞濡�鈥崇础 */
    data class Report(val reportText: String = "", val isLoading: Boolean = true) : AppState()

    /** 閸樺棗褰剁拋鏉跨秿濡�鈥崇础 */
    object History : AppState()

    /** AI閸斻劎鏁惧Ο鈥崇础 */
    object Animation : AppState()

    /** 閻�銉ㄧ槕瀵ゆ湹鍑犲Ο鈥崇础 */
    data class Knowledge(
            val summary: String = "",
            val mistakes: String = "",
            val extension: String = "",
            val suggestedQuestions: List<String> = emptyList()
    ) : AppState()
}

/** 鐟欙綁顣介梼鑸殿唽 */
enum class SolveStage {
    UPLOADING, // 娑撳﹣绱舵稉?
    ANALYZING, // 閸掑棙鐎芥稉?
    DISPLAY_STEPS, // 閺勫墽銇氱憴锝夘暯閹�婵婄熅
    DISPLAY_FULL, // 閺勫墽銇氱�瑰本鏆ｇ憴锝嗙��
    DISPLAY_MINDMAP, // 閺勫墽銇氶幀婵堟樊鐎电厧娴�
    INTERACTIVE, // 娴溿倓绨伴幓鎰版６
    COMPLETED // 鐎瑰本鍨�
}

/** 娑撴挻鏁炴惔锔惧Ц閹�渚婄礄閺夈儴鍤滈張顒�婀撮幒銊ф倞濡�鈥崇�烽敍?*/
enum class FocusState(val label: String) {
    WRITING("娑旓箑鍟撴稉"),
    THINKING("閹�婵娾偓鍐ц厬"),
    PAGE_TURNING("缂堝�氥��"),
    SEEKING_HELP("濮瑰倸濮�");

    companion object {
        fun fromString(s: String): FocusState {
            return when (s.lowercase()) {
                "writing" -> WRITING
                "thinking" -> THINKING
                "page_turning" -> PAGE_TURNING
                "seeking_help" -> SEEKING_HELP
                else -> WRITING
            }
        }
    }
}

