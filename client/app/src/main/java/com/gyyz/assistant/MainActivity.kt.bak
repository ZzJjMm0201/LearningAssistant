)

@Composable
fun MainMenuScreen(
    viewModel: MainViewModel,
    statusText: String,
    gestureEnabled: Boolean = false,
) {
    Box(modifier = Modifier.fillMaxSize()) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(Color(0xFF0A0A1A))
        ) {
        // 妞ゅ爼鍎撮悩鑸碘偓浣圭埉
        TopStatusBar(statusText = statusText, viewModel = viewModel)

        // 閹靛��瀵氶弫浼村櫤閺勫墽銇氶敍鍫滅矌閸︺劍澧滈崝鑳�鐦戦崚顐㈢磻閸氼垱妞傞弰鍓с仛閿�?
        val fingerCount by viewModel.detectedFingerCount.collectAsState()
        if (gestureEnabled && fingerCount > 0) {
            FingerCountHint(fingerCount = fingerCount)
        }

        Spacer(modifier = Modifier.height(8.dp))

        // 閸欘垱绮撮崝銊ф畱閹稿�愭尦閸栧搫鐓�
        Column(
            modifier = Modifier
                .weight(1f)
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 16.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            val buttons = listOf(
                FunctionButtonData("棣冩懗 閹峰秶鍙庣憴锝夘暯", "娴肩�垮毉5閺嶈�勫�滈幐", Color(0xFF2196F3), { viewModel.onButtonSolve() }),
                FunctionButtonData("棣冨箑 AI閸斻劎鏁�", "娴肩�垮毉4閺嶈�勫�滈幐", Color(0xFF9C27B0), { viewModel.onButtonAnimation() }),
                FunctionButtonData("棣冩惓 閺佺増宓侀幎銉ユ啞", "娴肩�垮毉3閺嶈�勫�滈幐", Color(0xFFFF9800), { viewModel.loadDataReport() }),
                FunctionButtonData("棣冾樆 AI閹躲儱鎲�", "娴肩�垮毉2閺嶈�勫�滈幐", Color(0xFF4CAF50), { viewModel.loadAiReport() }),
                FunctionButtonData("棣冩憥 閻�銉ㄧ槕瀵ゆ湹鍑�", "娴肩�垮毉1閺嶈�勫�滈幐", Color(0xFF00BCD4), { viewModel.onButtonExtend() }),
                FunctionButtonData("棣冩惖 閸樺棗褰剁拋鏉跨秿", "閻愮懓鍤�閺屻儳婀�", Color(0xFF795548), { viewModel.showHistory() }),
                FunctionButtonData("閳挎瑱绗� 鐠佸墽鐤�", "娑擃亝鈧�褍瀵查柊宥囩枂", Color(0xFF607D8B), { viewModel.showSettings() }),
            )

            buttons.chunked(2).forEach { row ->
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    row.forEach { data ->
                        FunctionButton(
                            title = data.title,
                            subtitle = data.subtitle,
                            color = data.color,
                            onClick = data.onClick,
                            modifier = Modifier.weight(1f)
                        )
                    }
                    if (row.size == 1) {
                        Spacer(modifier = Modifier.weight(1f))
                    }
                }
            }

            // 鎼存洟鍎撮悾娆戞��
            Spacer(modifier = Modifier.height(32.dp))
        }

        // 鐠囶參鐓堕幃顒佽癁閹稿�愭尦閿涘牆褰告稉瀣�顫楅敍?
        VoiceFloatingActionButton(
            viewModel = viewModel,
            modifier = Modifier
                .align(Alignment.BottomEnd)
                .padding(16.dp)
        )
    }
}

