// ==================== 娑撶眲ctivity ====================

class MainActivity : ComponentActivity() {

    companion object {
        const val TAG = "LearningAssistant"
    }

    private lateinit var cameraExecutor: java.util.concurrent.ExecutorService

    // ===== 閻╁憡婧�閻╃�垮彠 =====
    private var imageCapture: ImageCapture? = null
    private val gestureRecognizerState = MutableStateFlow<HandGestureRecognizer?>(null)
    private val isCameraReady = MutableStateFlow(false)


    // 鏉╁�熼嚋閺夊啴妾洪悩鑸碘偓?
    private val hasCameraPermission = MutableStateFlow(false)

    // ViewModel 瀵�鏇犳暏
    private lateinit var mainViewModel: MainViewModel

    // ===== 閻╁憡婧�闁插秴鎯庣拋鈩冩殶閸ｎ煉绱欓悽銊ょ艾瀵�鍝勫煑rebind閿�?=====
    private val cameraRebindTrigger = MutableStateFlow(0)

    // ===== 閺傛澘顤冮敍姘�濯块悡褍娲栫拫?=====
    var onTakePhoto: ((ImageCapture) -> Unit)? = null

    // 閺夊啴妾虹拠閿嬬湴閿涘牅绗夐崣姗堢礆
    private val requestPermissionLauncher =
            registerForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) {
                    permissions ->
                val granted = permissions.values.all { it }
                if (granted) {
                    Log.d(TAG, "閹碘偓閺堝�嬫綀闂勬劕鍑￠幒鍫滅埃")
                    hasCameraPermission.value = true
                } else {
                    Log.w(TAG, "閺夊啴妾虹悮顐ｅ珕缂�")
                    Toast.makeText(this, "闂団偓鐟曚胶娴夐張鐑樻綀闂勬劖澧犻懗鑺ヮ劀鐢�闀愬▏閻�", Toast.LENGTH_LONG).show()
                    hasCameraPermission.value = false
                }
            }

    private val serverDiscoverer = ServerDiscoverer()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        discoverAndConnect()

        cameraExecutor = Executors.newSingleThreadExecutor()

        initGestureRecognizer()

        val hasCamera =
            ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) ==
                    PackageManager.PERMISSION_GRANTED
        val hasInternet =
            ContextCompat.checkSelfPermission(this, Manifest.permission.INTERNET) ==
                    PackageManager.PERMISSION_GRANTED
        Log.d(TAG, "閺夊啴妾洪悩鑸碘偓?- 閻╁憡婧�:$hasCamera, 缂冩垹绮�:$hasInternet")

        if (hasCamera) {
            hasCameraPermission.value = true
            Log.d(TAG, "閻╁憡婧�閺夊啴妾哄�稿弶宸挎禍鍫�绱濋惄瀛樺复鐠佸墽鐤�")
        } else {
            Log.d(TAG, "閻╁憡婧�閺夊啴妾洪張顏呭房娴滃牞绱濇稉璇插З鐠囬攱鐪�")
            requestPermissionLauncher.launch(
                arrayOf(
                    Manifest.permission.CAMERA,
                    Manifest.permission.INTERNET,
                    Manifest.permission.ACCESS_NETWORK_STATE,
                    Manifest.permission.RECORD_AUDIO,
                )
            )
        }

        setContent {
            LearningAssistantTheme {
                val viewModel = viewModel<MainViewModel>()
                mainViewModel = viewModel

                // 閸掓繂顫愰崠鏈卲iService閿涘湯haredPreferences + 閼奉亜濮╅惂璇茬秿濡�鈧�閺屻儻绱�
                LaunchedEffect(Unit) {
                    viewModel.initApiService(this@MainActivity)
                }

                // 缂佹垵鐣鹃幐澶愭尦閸ョ偠鐨熼弮鑸殿梾閺屻儳娴夐張铏瑰Ц閹�?
                // ===== 閻╁憡婧�閹稿�愭尦閸ョ偠鐨熼柅姘辨暏婢跺嫮鎮� =====
                fun requireCamera(action: String, takeAction: (ImageCapture) -> Unit) {
                    Log.d(TAG, "$action: imageCapture=${imageCapture}, isCameraReady=${isCameraReady.value}")
                    if (!isCameraReady.value) {
                        Toast.makeText(this@MainActivity, "閻╁憡婧�閺堫亜姘ㄧ紒顏庣礉鐠囬�庘棦閸氬骸鍟�鐠�", Toast.LENGTH_SHORT).show()
                        return
                    }
                    imageCapture?.let { capture ->
                        takeAction(capture)
                    } ?: run {
                        Log.e(TAG, "imageCapture 娑�?null")
                        Toast.makeText(this@MainActivity, "閻╁憡婧�閺堫亜姘ㄧ紒顏庣礉鐠囬�庘棦閸氬骸鍟�鐠�", Toast.LENGTH_SHORT).show()
                    }
                }

                viewModel.onButtonTakePhoto = {
                    requireCamera("onButtonTakePhoto") { capture ->
                        takePhotoAndUpload(capture, viewModel)
                    }
                }

                viewModel.onButtonAnimation = {
                    requireCamera("onButtonAnimation") { capture ->
                        takePhotoAndUploadAnimation(capture, viewModel)
                    }
                }

                viewModel.onButtonExtend = {
                    requireCamera("onButtonExtend") { capture ->
                        takePhotoAndUploadExtend(capture, viewModel)
                    }
                }

                MainScreen(
                    hasCameraPermission = hasCameraPermission.collectAsState().value,
                    gestureRecognizer = gestureRecognizerState.collectAsState().value,
                    viewModel = viewModel,
                    onImageCaptureReady = { capture ->
                        imageCapture = capture
                        isCameraReady.value = true  // 閻╁憡婧�鐏忚京鍗�
                        Log.d(TAG, "ImageCapture 瀹告彃姘ㄧ紒")
                    },
                    cameraRebindTrigger = cameraRebindTrigger.collectAsState().value
                )
            }
        }
    }

    private fun discoverAndConnect() {
        lifecycleScope.launch {
            // 瀵ゆ儼绻滄稉鈧�娑撳�剁礉缁涘�婄窡 setContent 娑�?mainViewModel 閸掓繂顫愰崠鏍х暚閹�?
            delay(500)
            val address = serverDiscoverer.discover()
            if (address != null) {
                Log.d(TAG, "閼奉亜濮╅崣鎴犲箛閹存劕濮�: $address")
                mainViewModel.updateServerAddress(address)
            } else {
                Log.w(TAG, "閺堫亜褰傞悳鐗堟箛閸旓紕顏�閿涘苯鐨㈡担璺ㄦ暏姒涙�款吇閸︽澘娼�")
            }
        }
    }

    private fun takePhotoAndUpload(capture: ImageCapture, viewModel: MainViewModel) {
        // 濞ｈ�插�為惄鍛婃簚閻樿埖鈧�浣诡梾閺�?
        if (!isCameraReady.value) {
            viewModel.onPhotoError("閻╁憡婧�閺堫亜姘ㄧ紒")
            return
        }

        val photoFile = java.io.File(externalCacheDir, "solve_${System.currentTimeMillis()}.jpg")
        val outputOptions = ImageCapture.OutputFileOptions.Builder(photoFile).build()

        // 鐠佸墽鐤嗙搾鍛�妞傞敍宀勪缉閸忓秵妫ら梽鎰�鐡戝��?
        val mainHandler = Handler(Looper.getMainLooper())
        val timeoutRunnable = Runnable {
            Log.e(TAG, "閹峰秶鍙庣搾鍛�妞�")
            viewModel.onPhotoError("閹峰秶鍙庣搾鍛�妞�")
        }
        mainHandler.postDelayed(timeoutRunnable, 5000)

        capture.takePicture(
            outputOptions,
            cameraExecutor,
            object : ImageCapture.OnImageSavedCallback {
                override fun onImageSaved(output: ImageCapture.OutputFileResults) {
                    mainHandler.removeCallbacks(timeoutRunnable)
                    Log.d(TAG, "閻撗呭�栧�歌弓绻氱��? ${photoFile.absolutePath}")
                    viewModel.onPhotoReady(photoFile)
                }

                override fun onError(exception: ImageCaptureException) {
                    mainHandler.removeCallbacks(timeoutRunnable)
                    Log.e(TAG, "閹峰秶鍙庢径杈�瑙�: ${exception.message}")
                    // 婵″倹鐏夐惄鍛婃簚瀹告彃鍙ч梻顓ㄧ礉鐏忔繆鐦�闁插秵鏌婄紒鎴濈暰
                    if (exception.message?.contains("closed") == true) {
                        isCameraReady.value = false
                        imageCapture = null
                        // 鐟欙箑褰傞惄鍛婃簚闁插秵鏌婄紒鎴濈暰
                        cameraRebindTrigger.value += 1
                    }
                    viewModel.onPhotoError(exception.message ?: "閹峰秶鍙庢径杈�瑙�")
                }
            }
        )
    }

    private fun takePhotoAndUploadAnimation(capture: ImageCapture, viewModel: MainViewModel) {
        val photoFile = java.io.File(externalCacheDir, "anim_${System.currentTimeMillis()}.jpg")

        val outputOptions = ImageCapture.OutputFileOptions.Builder(photoFile).build()

        capture.takePicture(
                outputOptions,
                cameraExecutor,
                object : ImageCapture.OnImageSavedCallback {
                    override fun onImageSaved(output: ImageCapture.OutputFileResults) {
                        Log.d(TAG, "閸斻劎鏁鹃悡褏澧栧�歌弓绻氱��? ${photoFile.absolutePath}")
                        viewModel.requestAnimation(photoFile)
                    }

                    override fun onError(exception: ImageCaptureException) {
                        Log.e(TAG, "閹峰秶鍙庢径杈�瑙�: ${exception.message}")
                    }
                }
        )
    }

    // 閸掓繂顫愰崠鏍ㄥ�滈崝鑳�鐦戦崚顐㈡珤閿涘牆鎮楅崣鏉垮�炴潪鑺ツ侀崹瀣剁礉闁�鍨�鍘ら梼璇差敚娑撹崵鍤庣粙瀣剁礆
    private fun initGestureRecognizer() {
        lifecycleScope.launch(Dispatchers.IO) {
            val recognizer = HandGestureRecognizer(
                    context = this@MainActivity,
                    onGestureDetected = { fingerCount ->
                        Log.d(TAG, "閹靛��濞嶇拠鍡楀焼: $fingerCount 閺嶈�勫�滈幐")
                            runOnUiThread {
                                when (fingerCount) {
                                    5 -> {
                                        // ===== 缁斿��宓嗛幏宥囧弾閿涘奔绗夐棁鈧�鐟曚胶顑囨禍灞绢偧绾�顔款吇 =====
                                        mainViewModel.startSolving()
                                        imageCapture?.let { capture ->
                                            takePhotoAndUpload(capture, mainViewModel)
                                        }
                                                ?: Log.e(TAG, "imageCapture 娑撹櫣鈹栭敍灞炬￥濞夋洘濯块悡")
                                    }
                                    4 -> {
                                        // AI閸斻劎鏁� - 閹峰秶鍙庨悽鐔稿灇閸斻劎鏁�
                                        imageCapture?.let { capture ->
                                            takePhotoAndUploadAnimation(capture, mainViewModel)
                                        }
                                                ?: Log.e(TAG, "imageCapture 娑撹櫣鈹栭敍灞炬￥濞夋洘濯块悡")
                                    }
                                    3 -> {
                                        // 閺佺増宓侀悧鍫濐劅閹�鍛�濮ら崨?
                                        mainViewModel.onGestureDetected(3)
                                    }
                                    2 -> {
                                        // AI閻楀牆顒熼幆鍛�濮ら崨?
                                        mainViewModel.onGestureDetected(2)
                                    }
                                    1 -> {
                                        // 閻�銉ㄧ槕瀵ゆ湹鍑�
                                        imageCapture?.let { capture ->
                                            takePhotoAndUploadExtend(capture, mainViewModel)
                                        }
                                    }
                                }
                            }
                        },
                        onFingerCountChanged = { fingerCount ->
                            runOnUiThread { mainViewModel.setFingerCount(fingerCount) }
                        },
                        onError = { error ->
                            Log.e(TAG, "閹靛��濞嶇拠鍡楀焼闁挎瑨顕�: ${error.message}")
                            runOnUiThread {
                                Toast.makeText(this@MainActivity, "閹靛��濞嶇拠鍡楀焼婢惰精瑙�: ${error.message}", Toast.LENGTH_SHORT)
                                        .show()
                            }
                        }
                )
            
            // 閸掑洤娲栨稉鑽ゅ殠缁嬪��顔曠純?gestureRecognizer閿涘牅绱扮憴锕�褰� Compose 闁插秶绮嶉敍?
            withContext(Dispatchers.Main) {
                gestureRecognizerState.value = recognizer
                Log.d(TAG, "閹靛��濞嶇拠鍡楀焼閸ｃ劌鍨垫慨瀣�瀵茬�瑰本鍨�")
            }
        }
    }

    private fun requestCameraPermissions() {
        val permissions =
                arrayOf(
                        Manifest.permission.CAMERA,
                        Manifest.permission.INTERNET,
                        Manifest.permission.ACCESS_NETWORK_STATE,
                )

        val needRequest =
                permissions.any {
                    val hasIt =
                            ContextCompat.checkSelfPermission(this, it) ==
                                    PackageManager.PERMISSION_GRANTED
                    Log.d(TAG, "閺夊啴妾� $it: ${if (hasIt) "瀹稿弶宸挎禍? else "閺堫亝宸挎禍?}")
                    !hasIt
                }

        if (needRequest) {
            Log.d(TAG, "濮濓絽婀�鐠囬攱鐪伴弶鍐�妾�...")
            requestPermissionLauncher.launch(permissions)
        } else {
            Log.d(TAG, "閹碘偓閺堝�嬫綀闂勬劕鍑￠幒鍫滅埃閿涘本妫ら棁鈧�鐠囬攱鐪�")
            hasCameraPermission.value = true
        }
    }

    private fun takePhotoAndUploadExtend(capture: ImageCapture, viewModel: MainViewModel) {
        val photoFile = java.io.File(externalCacheDir, "extend_${System.currentTimeMillis()}.jpg")

        val outputOptions = ImageCapture.OutputFileOptions.Builder(photoFile).build()

        capture.takePicture(
                outputOptions,
                cameraExecutor,
                object : ImageCapture.OnImageSavedCallback {
                    override fun onImageSaved(output: ImageCapture.OutputFileResults) {
                        Log.d(TAG, "瀵ゆ湹鍑犻悡褏澧栧�歌弓绻氱��? ${photoFile.absolutePath}")
                        viewModel.requestKnowledgeExtension(photoFile)
                    }

                    override fun onError(exception: ImageCaptureException) {
                        Log.e(TAG, "閹峰秶鍙庢径杈�瑙�: ${exception.message}")
                    }
                }
        )
    }

    override fun onDestroy() {
        super.onDestroy()
        gestureRecognizerState.value?.close()
        cameraExecutor.shutdown()
    }
}

// ==================== 娑撹崵鏅�闂�?====================
@Composable
fun MainScreen(
    hasCameraPermission: Boolean = false,
    gestureRecognizer: HandGestureRecognizer? = null,
    viewModel: MainViewModel,
    onImageCaptureReady: ((ImageCapture) -> Unit)? = null,
    cameraRebindTrigger: Int = 0,  // 閸旂姴鍩屾潻娆庨嚋閸欏倹鏆熼悽銊ょ艾瀵�鍝勫煑rebind
) {
    val appState by viewModel.appState.collectAsState()
    val statusText by viewModel.statusText.collectAsState()
    val gestureEnabled by viewModel.gestureEnabled.collectAsState()
    val isMainScreen = appState is AppState.Tracking

    Box(modifier = Modifier.fillMaxSize().background(Color(0xFF0A0A1A))) {
        // 閻╁憡婧�妫板嫯顫� - 婵�瀣�绮撴穱婵囧瘮閸︺劌鎮楅崣鎷岀箥鐞涘矉绱欐稉宥夋�㈤悩鑸碘偓浣稿瀼閹广垼鈧�宀勬敘濮�?闁插秴缂撻敍?
        if (hasCameraPermission) {
            CameraPreviewView(
                modifier = if (isMainScreen) Modifier.fillMaxSize() else Modifier.fillMaxSize().alpha(0f),
                gestureRecognizer = if (gestureEnabled && isMainScreen) gestureRecognizer else null,
                onImageCaptureReady = onImageCaptureReady,
                onCameraReady = {
                    Log.d("MainScreen", "閻╁憡婧�瀹告彃姘ㄧ紒")
                },
                rebindKey = cameraRebindTrigger
            )
        }
        // 閸撳秵娅欓崘鍛�顔�
        when (val state = appState) {
            is AppState.Login ->
                LoginScreen(
                    isLoading = state.isLoading,
                    error = state.error,
                    onLogin = { username, password -> viewModel.login(username, password) },
                    onRegister = { username, password -> viewModel.register(username, password) },
                )
            is AppState.Tracking ->
                MainMenuScreen(
                    viewModel = viewModel,
                    statusText = statusText,
                    gestureEnabled = gestureEnabled,
                )
            is AppState.Solving ->
                SolvingScreen(
                    solveState = state,
                    showModules = viewModel.showModules.collectAsState().value,
                    onAskQuestion = { viewModel.askQuestion(it) },
                    onBack = { viewModel.backToTracking() },
                )
            is AppState.Report -> {
                val isDataReport = state.reportText.startsWith("http")
                if (state.isLoading) {
                    LoadingOverlay("濮濓絽婀�閻㈢喐鍨氶幎銉ユ啞...")
                } else {
                    ReportScreen(
                            report = state,
                            onBack = { viewModel.backToTracking() },
                            reportUrl = if (isDataReport) state.reportText else "",
                            reportText = if (!isDataReport) state.reportText else "",
                    )
                }
            }
            is AppState.Animation -> {
                val animUrl = viewModel.animationUrl.collectAsState().value
                if (animUrl.isEmpty()) {
                    LoadingOverlay("濮濓絽婀�閻㈢喐鍨氶崝銊ф暰...")
                } else {
                    AnimationScreen(
                            onBack = { viewModel.backToTracking() },
                            animationUrl = animUrl
                    )
                }
            }
            is AppState.History ->
                    HistoryScreen(
                            onBack = { viewModel.backToTracking() },
                    )
            is AppState.Knowledge ->
                    KnowledgeScreen(
                            state = state,
                            showModules = viewModel.showModules.collectAsState().value,
                            onAskQuestion = { viewModel.askQuestion(it) },
                            onBack = { viewModel.backToTracking() },
                    )
        }

        // 濞嗐垼绻�/鐠佸墽鐤�/閸樺棗褰跺��鍦�鐛�
        if (viewModel.showWelcomeDialog.collectAsState().value) {
            WelcomeDialog(onDismiss = { viewModel.showWelcomeDialog.value = false })
        }

        if (viewModel.showSettingsDialog.collectAsState().value) {
            SettingsDialog(
                    viewModel = viewModel,
                    onDismiss = { viewModel.showSettingsDialog.value = false }
            )
        }
        if (viewModel.showHistoryScreen.collectAsState().value) {
            HistoryViewScreen(
                viewModel = viewModel,
                onBack = { viewModel.showHistoryScreen.value = false }
            )
        }
    }
}

// ==================== 閻╁憡婧�妫板嫯顫� ====================
// MainActivity.kt - 閺囨寧宕� CameraPreviewView 閸戣姤鏆�

@Composable
fun CameraPreviewView(
    modifier: Modifier = Modifier,
    gestureRecognizer: HandGestureRecognizer? = null,
    onImageCaptureReady: ((ImageCapture) -> Unit)? = null,
    onCameraReady: (() -> Unit)? = null,
    rebindKey: Int = 0,  // 閸欐ê瀵查弮璺哄繁閸掔�梕bind
) {
    val context = LocalContext.current
    val lifecycleOwner = androidx.lifecycle.compose.LocalLifecycleOwner.current

    val hasPermission =
        ContextCompat.checkSelfPermission(context, Manifest.permission.CAMERA) ==
                PackageManager.PERMISSION_GRANTED

    if (!hasPermission) {
        Box(modifier = modifier.background(Color.Black))
        return
    }

    // 娴ｈ法鏁� remember 娣囨繃瀵旈惄鍛婃簚閻樿埖鈧�渚婄礉闁�鍨�鍘ら柌宥咁槻閸掓繂顫愰崠?
    val cameraState = remember {
        mutableStateOf<ProcessCameraProvider?>(null)
    }

    val imageCaptureRef = remember { mutableStateOf<ImageCapture?>(null) }
    val isBound = remember { mutableStateOf(false) }

    // 閼惧嘲褰� CameraProvider閿涘牆褰查柌宥堢槸閿涘矂鈧�鍌炲帳濡�鈩冨珯閸�?CameraX 閸掓繂顫愰崠鏍ф�㈡潻鐕傜礆
    LaunchedEffect(Unit) {
        var retryCount = 0
        val maxRetries = 5
        while (retryCount < maxRetries && cameraState.value == null) {
            try {
                val cameraProvider = withContext(Dispatchers.IO) {
                    val future = ProcessCameraProvider.getInstance(context)
                    try {
                        future.get(10, java.util.concurrent.TimeUnit.SECONDS)
                    } catch (e: java.util.concurrent.TimeoutException) {
                        Log.w("CameraPreview", "閼惧嘲褰� CameraProvider 鐡掑懏妞� (缁�?{retryCount + 1}濞�?")
                        null
                    }
                }
                if (cameraProvider != null) {
                    cameraState.value = cameraProvider
                    Log.d("CameraPreview", "CameraProvider 閼惧嘲褰囬幋鎰�濮�")
                } else {
                    retryCount++
                    if (retryCount < maxRetries) {
                        delay(2000) // 缁涘�婄窡2缁夋帒鎮楅柌宥堢槸
                    }
                }
            } catch (e: Exception) {
                Log.e("CameraPreview", "閼惧嘲褰� CameraProvider 婢惰精瑙� (缁�?{retryCount + 1}濞�?", e)
                retryCount++
                if (retryCount < maxRetries) {
                    delay(2000)
                }
            }
        }
        if (cameraState.value == null) {
            Log.e("CameraPreview", "CameraProvider 閼惧嘲褰囨径杈�瑙﹂敍灞藉嚒闁插秷鐦� $maxRetries 濞�")
        }
    }

    // 缂佹垵鐣鹃惄鍛婃簚閿涘潌indToLifecycle 韫囧懘銆忛崷銊ゅ瘜缁捐法鈻肩拫鍐�鏁ら敍?
    LaunchedEffect(cameraState.value, lifecycleOwner, rebindKey) {
        val cameraProvider = cameraState.value ?: return@LaunchedEffect
        val currentLifecycle = lifecycleOwner

        // 閸忓牐袙缂佹垶澧嶉張?
        cameraProvider.unbindAll()
        isBound.value = false

        // 閸掓稑缂� Preview
        val preview = Preview.Builder().build()

        // 閸掓稑缂� ImageCapture
        val imageCapture = ImageCapture.Builder()
            .setCaptureMode(ImageCapture.CAPTURE_MODE_MAXIMIZE_QUALITY)
            .build()

        val useCases = mutableListOf<UseCase>(preview, imageCapture)

        // 濞ｈ�插�為幍瀣�濞嶉崚鍡樼��
        if (gestureRecognizer != null) {
            val analyzer = CameraAnalyzer(gestureRecognizer, processIntervalMs = 60)
            val imageAnalysis = ImageAnalysis.Builder()
                .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
                .build()
                .also {
                    it.setAnalyzer(ContextCompat.getMainExecutor(context), analyzer)
                }
            useCases.add(imageAnalysis)
        }

        try {
            // bindToLifecycle 韫囧懘銆忔潻鎰�顢戦崷銊ゅ瘜缁捐法鈻奸敍瀛媋meraX 娓氭繆绂嗘稉鑽ゅ殠缁嬪��娈� Looper
            withContext(Dispatchers.Main) {
                cameraProvider.bindToLifecycle(
                    currentLifecycle,
                    CameraSelector.DEFAULT_BACK_CAMERA,
                    *useCases.toTypedArray()
                )
            }

            imageCaptureRef.value = imageCapture
            onImageCaptureReady?.invoke(imageCapture)
            isBound.value = true
            onCameraReady?.invoke()

            Log.d("CameraPreview", "閻╁憡婧�缂佹垵鐣鹃幋鎰�濮�")
        } catch (e: Exception) {
            Log.e("CameraPreview", "閻╁憡婧�缂佹垵鐣炬径杈�瑙�", e)
        }
    }

    // 瑜�?gestureRecognizer 閸欐ê瀵查弮璁圭礉閸楁洜瀚�閺囧瓨鏌� ImageAnalysis
    LaunchedEffect(gestureRecognizer) {
        val cameraProvider = cameraState.value ?: return@LaunchedEffect
        if (!isBound.value) return@LaunchedEffect
        
        // 缁夊�氭珟閺冄呮畱閹靛��濞嶉崚鍡樼�介崳?
        cameraProvider.unbindAll()
        
        val preview = Preview.Builder().build()
        val imageCapture = ImageCapture.Builder()
            .setCaptureMode(ImageCapture.CAPTURE_MODE_MAXIMIZE_QUALITY)
            .build()
        
        val useCases = mutableListOf<UseCase>(preview, imageCapture)

        if (gestureRecognizer != null) {
            val analyzer = CameraAnalyzer(gestureRecognizer, processIntervalMs = 60)
            val imageAnalysis = ImageAnalysis.Builder()
                .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
                .build()
                .also {
                    it.setAnalyzer(ContextCompat.getMainExecutor(context), analyzer)
                }
            useCases.add(imageAnalysis)
        }
        
        try {
            // bindToLifecycle 韫囧懘銆忔潻鎰�顢戦崷銊ゅ瘜缁捐法鈻�
            cameraProvider.bindToLifecycle(
                lifecycleOwner,
                CameraSelector.DEFAULT_BACK_CAMERA,
                *useCases.toTypedArray()
            )
            imageCaptureRef.value = imageCapture
            onImageCaptureReady?.invoke(imageCapture)
            Log.d("CameraPreview", "Gesture: ${if (gestureRecognizer != null) "enabled" else "disabled"}")
        } catch (e: Exception) {
            Log.e("CameraPreview", "Failed to update gesture analyzer", e)
        }
    }

    // 鐟欙絿绮﹂弮鑸电�婚悶?
    DisposableEffect(Unit) {
        onDispose {
            try {
                cameraState.value?.unbindAll()
                Log.d("CameraPreview", "閻╁憡婧�瀹歌尪袙缂�")
            } catch (e: Exception) {
                Log.e("CameraPreview", "鐟欙絿绮﹂惄鍛婃簚婢惰精瑙�", e)
            }
        }
    }

    // 缁岃櫣娈� Composable閿涘奔绗夐棁鈧�鐟曚焦妯夌粈娲�顣╃憴?
    Box(modifier = modifier)
}

// ==================== 鐠虹喕閲滅�涳缚绡勯崣鐘插�炵仦?====================

@Composable
fun TrackingOverlay(
        statusText: String,
        pomodoroTime: Int,
        pageCount: Int,
        thinkingTimer: Int,
        fingerCount: Int = 0, // 閳�?閺傛澘顤冮崣鍌涙殶
) {
    Box(modifier = Modifier.fillMaxSize()) {
        // 妞ゅ爼鍎撮悩鑸碘偓浣圭埉
        Column(
                modifier =
                        Modifier.align(Alignment.TopCenter)
                                .padding(16.dp)
                                .background(Color(0xAA000000))
                                .padding(12.dp)
        ) {
            Text(
                    text = statusText,
                    color = Color.White,
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold
            )
            Spacer(modifier = Modifier.height(4.dp))

            Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween
            ) {
                Text(text = "${formatTime(pomodoroTime)}", color = Color.White, fontSize = 14.sp)
                Text(text = "瀹告彃浠�${pageCount}妞�", color = Color.White, fontSize = 14.sp)
            }

            if (thinkingTimer > 0) {
                Text(
                        text = "閹�婵娾偓鍐ц厬... ${thinkingTimer}s",
                        color = Color(0xFFFFD700),
                        fontSize = 14.sp,
                        modifier = Modifier.padding(top = 4.dp)
                )
            }
        }

        // ===== 閹靛��瀵氶弫浼村櫤閺勫墽銇氶敍鍫ｇ殶鐠囨洜鏁ら敍?=====
        if (fingerCount > 0) {
            Text(
                    text = "$fingerCount 閺嶈�勫�滈幐",
                    color = Color(0xFF00FF00),
                    fontSize = 48.sp,
                    fontWeight = FontWeight.Bold,
                    modifier =
                            Modifier.align(Alignment.Center)
                                    .background(Color(0xAA000000))
                                    .padding(16.dp)
            )
        }

        // 鎼存洟鍎撮幍瀣�濞嶉幓鎰�銇氶敍鍫滅矌閸︺劍澧滈崝鑳�鐦戦崚顐㈢磻閸氼垱妞傞弰鍓с仛閿�?
        if (fingerCount > 0) {
            Text(
                    text = "閹靛��濞嶉崨鎴掓姢: 5閳�鎺曅掓０?| 4閳�鎺戝З閻�?| 3閳�鎺撴殶閹诡喗濮ら崨?| 2閳�鎵怚閹躲儱鎲� | 1閳�鎺旂叀鐠囧棗娆㈡导",
                    color = Color.White.copy(alpha = 0.7f),
                    fontSize = 12.sp,
                    modifier =
                            Modifier.align(Alignment.BottomCenter)
                                    .padding(16.dp)
                                    .background(Color(0x55000000))
                                    .padding(8.dp)
            )
        }
    }
}

// ==================== 閻ц�茬秿濞夈劌鍞介悾宀勬桨 ====================

@Composable
fun LoginScreen(
    isLoading: Boolean = false,
    error: String = "",
    onLogin: (String, String) -> Unit,
    onRegister: (String, String) -> Unit,
) {
    var username by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }
    var isRegisterMode by remember { mutableStateOf(false) }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF0A0A1A))
            .padding(32.dp),
        contentAlignment = Alignment.Center
    ) {
        Card(
            modifier = Modifier.fillMaxWidth(),
            colors = CardDefaults.cardColors(containerColor = Color(0xFF16213E)),
            shape = RoundedCornerShape(16.dp)
        ) {
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(24.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                // 閺嶅洭顣�
                Text(
                    text = "棣冩憥 鐎涳缚绡勯崝鈺傚��",
                    color = Color(0xFF00D2FF),
                    fontSize = 28.sp,
                    fontWeight = FontWeight.Bold
                )
                Spacer(modifier = Modifier.height(4.dp))
                Text(
                    text = if (isRegisterMode) "閸掓稑缂撻弬鎷屽�勯崣" else "閻ц�茬秿",
                    color = Color.Gray,
                    fontSize = 14.sp
                )

                Spacer(modifier = Modifier.height(24.dp))

                // 閻�銊﹀煕閸氬秷绶�閸�?
                OutlinedTextField(
                    value = username,
                    onValueChange = { username = it },
                    label = { Text("閻�銊﹀煕閸�", color = Color.Gray) },
                    modifier = Modifier.fillMaxWidth(),
                    singleLine = true,
                    enabled = !isLoading,
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedTextColor = Color.White,
                        unfocusedTextColor = Color.White,
                        focusedBorderColor = Color(0xFF00D2FF),
                        unfocusedBorderColor = Color.Gray,
                        cursorColor = Color(0xFF00D2FF),
                    )
                )

                Spacer(modifier = Modifier.height(12.dp))

                // 鐎靛棛鐖滄潏鎾冲弳
                OutlinedTextField(
                    value = password,
                    onValueChange = { password = it },
                    label = { Text("鐎靛棛鐖�", color = Color.Gray) },
                    modifier = Modifier.fillMaxWidth(),
                    singleLine = true,
                    enabled = !isLoading,
                    visualTransformation = androidx.compose.ui.text.input.PasswordVisualTransformation(),
                    colors = OutlinedTextFieldDefaults.colors(
                        focusedTextColor = Color.White,
                        unfocusedTextColor = Color.White,
                        focusedBorderColor = Color(0xFF00D2FF),
                        unfocusedBorderColor = Color.Gray,
                        cursorColor = Color(0xFF00D2FF),
                    )
                )

                // 闁挎瑨顕ら幓鎰�銇�
                if (error.isNotEmpty()) {
                    Spacer(modifier = Modifier.height(8.dp))
                    Text(
                        text = error,
                        color = Color(0xFFFF5722),
                        fontSize = 13.sp
                    )
                }

                Spacer(modifier = Modifier.height(20.dp))

                // 閻ц�茬秿/濞夈劌鍞介幐澶愭尦
                Button(
                    onClick = {
                        if (username.isNotBlank() && password.isNotBlank()) {
                            if (isRegisterMode) {
                                onRegister(username.trim(), password)
                            } else {
                                onLogin(username.trim(), password)
                            }
                        }
                    },
                    modifier = Modifier.fillMaxWidth().height(48.dp),
                    enabled = !isLoading && username.isNotBlank() && password.isNotBlank(),
                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF00D2FF)),
                    shape = RoundedCornerShape(8.dp)
                ) {
                    if (isLoading) {
                        CircularProgressIndicator(
                            color = Color.White,
                            modifier = Modifier.size(20.dp),
                            strokeWidth = 2.dp
                        )
                    } else {
                        Text(
                            text = if (isRegisterMode) "濞夈劌鍞�" else "閻ц�茬秿",
                            color = Color.Black,
                            fontSize = 16.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }

                Spacer(modifier = Modifier.height(12.dp))

                // 閸掑洦宕查惂璇茬秿/濞夈劌鍞�
                TextButton(onClick = { isRegisterMode = !isRegisterMode }) {
                    Text(
                        text = if (isRegisterMode) {
                            "瀹稿弶婀佺拹锕�褰块敍鐔哄仯閸戣崵娅ヨぐ"
                        } else {
                            "濞屸剝婀佺拹锕�褰块敍鐔哄仯閸戠粯鏁為崘"
                        },
                        color = Color(0xFF00D2FF),
                        fontSize = 14.sp
                    )
                }
            }
        }
    }
}

// ==================== 鐟欙綁顣介悾宀勬桨 ====================

@Composable
fun SolvingScreen(
        solveState: AppState.Solving,
        showModules: Map<String, Boolean> = emptyMap(),
        onAskQuestion: (String) -> Unit,
        onBack: () -> Unit,
) {
    Column(
            modifier =
                    Modifier.fillMaxSize()
                            .background(Color(0xFF1A1A2E))
                            .verticalScroll(rememberScrollState())
                            .padding(16.dp)
    ) {
        // 妞ゅ爼鍎寸�佃壈鍩�
        Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
        ) {
            Button(onClick = onBack) { Text("鏉╂柨娲�") }
            Text(
                    text =
                            when (solveState.stage) {
                                SolveStage.UPLOADING -> "娑撳﹣绱舵稉?.."
                                SolveStage.ANALYZING -> "閸掑棙鐎芥稉?.."
                                SolveStage.DISPLAY_STEPS -> "鐟欙綁顣介幀婵婄熅"
                                SolveStage.DISPLAY_FULL -> "鐎瑰本鏆ｇ憴锝嗙��"
                                SolveStage.DISPLAY_MINDMAP -> "閹�婵堟樊鐎电厧娴�"
                                SolveStage.INTERACTIVE -> "娴滄帒濮╅梻顔剧摕"
                                SolveStage.COMPLETED -> "鐟欙絿鐡熺�瑰本鍨�"
                            },
                    color = Color.White,
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
            )
        }

        Spacer(modifier = Modifier.height(16.dp))

        // 閹�婵娾偓鍐ㄥЗ閻�?
        if (solveState.stage == SolveStage.UPLOADING || solveState.stage == SolveStage.ANALYZING) {
            Box(
                    modifier = Modifier.fillMaxWidth().height(200.dp),
                    contentAlignment = Alignment.Center
            ) {
                CircularProgressIndicator(color = Color(0xFF00D2FF))
                Text(
                        text = "濮濓絽婀�閸掑棙鐎芥０妯兼窗...",
                        color = Color.White,
                        modifier = Modifier.padding(top = 80.dp)
                )
            }
        }

        // 鐟欙綁顣介幀婵婄熅
        if (solveState.solutionSteps.isNotEmpty() && showModules.getOrDefault("solution_steps", true)) {
            SolutionCard(
                    title = "棣冩寱 鐟欙綁顣介幀婵婄熅",
                    content = solveState.solutionSteps,
                    color = Color(0xFF00D2FF)
            )
        }

        // 鐎瑰本鏆ｇ憴锝嗙��
        if (solveState.fullSolution.isNotEmpty() && showModules.getOrDefault("full_solution", true)) {
            SolutionCard(
                    title = "棣冩憫 鐎瑰本鏆ｇ憴锝嗙��",
                    content = solveState.fullSolution,
                    color = Color(0xFF7B2FBE)
            )
        }

        // 閹�婵堟樊鐎电厧娴�
        if (solveState.mindMap.isNotEmpty() && showModules.getOrDefault("mind_map", true)) {
            SolutionCard(
                    title = "棣冩�囬敂?閹�婵堟樊鐎电厧娴�",
                    content = solveState.mindMap,
                    color = Color(0xFF00C853)
            )
        }

        // 瀵ゆ湹鍑犻梻顕�顣�
        if (solveState.suggestedQuestions.isNotEmpty() && showModules.getOrDefault("suggested_questions", true)) {
            Text(
                    text = "棣冩尠 娴ｇ姴褰查懗鍊熺箷閹�鎶芥６閿�",
                    color = Color.White,
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(top = 16.dp, bottom = 8.dp)
            )

            solveState.suggestedQuestions.forEach { question ->
                Button(
                        onClick = { onAskQuestion(question) },
                        modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
                        colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF2D2D44))
                ) { Text(question, color = Color.White, fontSize = 14.sp) }
            }
        }
    }

    // ===== "娴ｇ姴褰查懗鍊熺箷閹�鎶芥６" 鐎电�呯樈濡楀棴绱欑憴锝夘暯鐎瑰本鍨氶梼鑸殿唽閿�?=====
    var askDialogDismissed by remember { mutableStateOf(false) }
    if (solveState.stage == SolveStage.COMPLETED && !askDialogDismissed) {
        AskDialog(
            suggestedQuestions = solveState.suggestedQuestions,
            onAsk = { question ->
                askDialogDismissed = true
                onAskQuestion(question)
            },
            onDismiss = { askDialogDismissed = true }
        )
    }
}

