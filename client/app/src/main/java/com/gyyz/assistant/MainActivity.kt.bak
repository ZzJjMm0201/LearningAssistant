    private fun startTomato() {
        pomodoroJob?.cancel()
        pomodoroJob = viewModelScope.launch {
            while (isActive && tomatoEnabled.value) {
                delay(1000)
                if (_pomodoroTime.value > 0) {
                    _pomodoroTime.value -= 1
                } else {
                    _statusText.value = "鐎瑰本鍨氭稉鈧�娑擃亞鏆橀懠鍕�鎸撻敍浣风搐閹�顖欑�存稉瀣�鎯倊"
                    _pomodoroTime.value = 25 * 60
                }
            }
        }
    }

    /** 閸氼垰濮╃捄鐔婚嚋鐎涳缚绡勫Ο鈥崇础 */
    private fun startTracking() {
        _appState.value = AppState.Tracking

        // 閻ｎ亣瀵楅柦鐔烘暠 init 娑擃厾娈� tomatoEnabled.collect 缂佺喍绔寸粻锛勬倞
        if (tomatoEnabled.value) {
            _pomodoroTime.value = 25 * 60
            startTomato()
        }
    }

    /** 婢跺嫮鎮婃稉鎾存暈鎼达妇濮搁幀浣稿綁閸�?*/
    fun onFocusStateChanged(focusState: FocusState) {
        when (focusState) {
            FocusState.THINKING -> {
                thinkingJob?.cancel()
                thinkingJob =
                        viewModelScope.launch {
                            _thinkingTimer.value = 0
                            while (_thinkingTimer.value < 30) {
                                delay(1000)
                                _thinkingTimer.value += 1
                            }
                            // 閹�婵娾偓鍐�绉存潻?0缁夋帪绱濋懛顏勫З閸氼垰濮╃憴锝夘暯
                            _statusText.value = "闂団偓鐟曚礁搴滈崝鈺佹偋閿涚喐顒滈崷銊ュ櫙婢跺洩袙妫�?.."
                            startSolving()
                            thinkingJob?.cancel()
                        }
            }
            FocusState.PAGE_TURNING -> {
                _pageCount.value += 1
                thinkingJob?.cancel()
                _thinkingTimer.value = 0
            }
            FocusState.WRITING -> {
                thinkingJob?.cancel()
                _thinkingTimer.value = 0
            }
            FocusState.SEEKING_HELP -> {
                startSolving()
            }
        }
    }

    /** 婢跺嫮鎮婇幍瀣�濞嶉崨鎴掓姢 */
    fun onGestureDetected(fingerCount: Int) {
        when (fingerCount) {
            1 -> {
                _statusText.value = "閺囨潙顦块崝鐔诲厴..."
            }
            2 -> {
                _appState.value = AppState.Report(isLoading = true)
                loadAiReport()
            }
            3 -> {
                _appState.value = AppState.Report(isLoading = true)
                loadDataReport()
            }
            4 -> {
                _appState.value = AppState.Animation
            }
        }
    }

    /** 婢跺嫮鎮婄拠顓㈢叾閸涙垝鎶� */
    fun handleVoiceCommand(text: String) {
        when {
            text.contains("娑撳秳绱�") || text.contains("閹峰秶鍙�") || text.contains("鐟欙綁顣�") -> onButtonSolve()
            text.contains("閹跺�熻杽") || text.contains("閸斻劎鏁�") -> onButtonAnimation()
            text.contains("閸嬫矮绨�") || text.contains("婢舵艾鐨�") -> loadDataReport()
            text.contains("閹哄本褰�") || text.contains("娴滃棜袙") -> loadAiReport()
            text.contains("鏉╂ɑ鍏傛禍鍡毿�") || text.contains("瀵ゆ湹鍑�") -> onButtonExtend()
            else -> _statusText.value = "閺堫亣鐦戦崚顐㈠煂閸涙垝鎶�: $text"
        }
    }

    /** 閸氼垰濮╃憴锝夘暯濞翠胶鈻� */
    fun startSolving() {
        _appState.value = AppState.Solving(stage = SolveStage.UPLOADING)
        _statusText.value = "濮濓絽婀�閹峰秶鍙�..."
    }

    /** 閻撗呭�栫亸杈╁崕閿涘苯绱戞慨瀣╃瑐娴肩姴鑻熺拠閿嬬湴AI鐟欙綁顣� */
    fun onPhotoReady(photoFile: java.io.File) {
        Log.d("MainViewModel", "閻撗呭�栫亸杈╁崕閿涘苯绱戞慨瀣╃瑐娴�? ${photoFile.absolutePath}")

        viewModelScope.launch(Dispatchers.IO) {
            try {
                withContext(Dispatchers.Main) {
                    _appState.value = AppState.Solving(stage = SolveStage.UPLOADING)
                    _statusText.value = "濮濓絽婀�娑撳﹣绱舵０妯兼窗..."
                }

                val photoBytes = photoFile.readBytes()
                Log.d("MainViewModel", "鐠嬪啰鏁� apiService.startSolve()")
                val requestId = apiService.startSolve(photoBytes)
                Log.d("MainViewModel", "娑撳﹣绱堕幋鎰�濮涢敍瀹篹questId=$requestId")

                // 閸掑洦宕查崚棰佸瘜缁捐法鈻奸弴瀛樻煀閻樿埖鈧�?
                withContext(Dispatchers.Main) {
                    _appState.value = AppState.Solving(stage = SolveStage.ANALYZING)
                    _statusText.value = "濮濓絽婀�閸掑棙鐎芥０妯兼窗..."
                }

                // 鏉╃偞甯碨SE
                Log.d("MainViewModel", "瀵�鈧�婵�瀣�绻涢幒顧橲E濞�?..")
                connectAndReceiveSSE(requestId)
            } catch (e: Exception) {
                Log.e("MainViewModel", "鐟欙綁顣芥径杈�瑙�: ${e.message}", e)
                withContext(Dispatchers.Main) {
                    _statusText.value = "鐟欙綁顣芥径杈�瑙�: ${e.message}"
                    _appState.value = AppState.Tracking
                }
            }
        }
    }

    /** 閻撗呭�栭幏宥嗘啔婢惰精瑙� */
    fun onPhotoError(error: String) {
        _statusText.value = "閹峰秶鍙庢径杈�瑙�: $error"
        _appState.value = AppState.Tracking
    }

    /** 鏉╃偞甯碨SE楠炶埖甯撮弨鎯靶掓０妯肩波閺�?*/
    private suspend fun connectAndReceiveSSE(requestId: String) {
        val client =
                OkHttpClient.Builder()
                        .connectTimeout(30, TimeUnit.SECONDS)
                        .readTimeout(0, TimeUnit.MILLISECONDS)
                        .build()

        val request =
                Request.Builder()
                        .url("${apiService.getBaseUrl()}/solve/stream/$requestId")
                        .header("Accept", "text/event-stream")
                        .build()

        Log.d("MainViewModel", "SSE鐠囬攱鐪癠RL: ${request.url}")

        try {
            val response = withContext(Dispatchers.IO) { client.newCall(request).execute() }

            if (!response.isSuccessful) {
                Log.e("MainViewModel", "SSE鏉╃偞甯存径杈�瑙�: ${response.code}")
                withContext(Dispatchers.Main) { _statusText.value = "鏉╃偞甯存径杈�瑙�: ${response.code}" }
                return
            }

            val reader = BufferedReader(InputStreamReader(response.body?.byteStream()))
            var eventType = ""
            var dataBuffer = StringBuilder()

            // 娣囨繂鐡ㄩ崥鍕�妯佸▓闈涘敶鐎�?
            var solutionSteps = ""
            var fullSolution = ""
            var mindMap = ""
            var suggestedQuestions = emptyList<String>()

            while (true) {
                val line = withContext(Dispatchers.IO) { reader.readLine() } ?: break

                when {
                    line.startsWith("event:") -> {
                        eventType = line.substring(6).trim()
                    }
                    line.startsWith("data:") -> {
                        dataBuffer.append(line.substring(5).trim())
                    }
                    line.isEmpty() && dataBuffer.isNotEmpty() -> {
                        val data = dataBuffer.toString()
                        Log.d("MainViewModel", "SSE娴滃�╂��: $data") // 閳�?閸忔娊鏁�閺冦儱绻�
                        dataBuffer = StringBuilder()

                        withContext(Dispatchers.Main) {
                            try {
                                val json = JSONObject(data)
                                val stage = json.optString("stage", "")

                                when (stage) {
                                    "info" ->
                                            _statusText.value = json.optString("content", "婢跺嫮鎮婃稉?..")
                                    "ocr_complete" -> _statusText.value = "濮濓絽婀�閹兼粎鍌ㄦ０妯虹氨..."
                                    "search_complete" -> _statusText.value = "AI濮濓絽婀�閸掑棙鐎�..."
                                    "question_info" -> _statusText.value = "濮濓絽婀�閻㈢喐鍨氱憴锝夘暯閹�婵婄熅..."
                                    "solution_steps" -> {
                                        solutionSteps = json.optString("content", "")
                                        _appState.value =
                                                AppState.Solving(
                                                        stage = SolveStage.DISPLAY_STEPS,
                                                        solutionSteps = solutionSteps
                                                )
                                    }
                                    "solution", "solution_rendered" -> {
                                        fullSolution = json.optString("content", "")
                                        _appState.value =
                                                AppState.Solving(
                                                        stage = SolveStage.DISPLAY_FULL,
                                                        solutionSteps = solutionSteps,
                                                        fullSolution = fullSolution
                                                )
                                    }
                                    "mindmap" -> {
                                        mindMap = json.optString("content", "")
                                        mindMap = "```\n" + mindMap + "\n"
                                        val formattedMindMap = mindMap
                                        _appState.value =
                                                AppState.Solving(
                                                        stage = SolveStage.DISPLAY_MINDMAP,
                                                        solutionSteps = solutionSteps,
                                                        fullSolution = fullSolution,
                                                        mindMap = formattedMindMap
                                                )
                                    }
                                    "suggested_questions" -> {
                                        val arr = json.optJSONArray("content")
                                        if (arr != null) {
                                            suggestedQuestions =
                                                    (0 until arr.length()).map { arr.getString(it) }
                                        }
                                        _appState.value =
                                                AppState.Solving(
                                                        stage = SolveStage.INTERACTIVE,
                                                        solutionSteps = solutionSteps,
                                                        fullSolution = fullSolution,
                                                        mindMap = mindMap,
                                                        suggestedQuestions = suggestedQuestions
                                                )
                                    }
                                    "complete" -> {
                                        _appState.value =
                                                AppState.Solving(
                                                        stage = SolveStage.COMPLETED,
                                                        solutionSteps = solutionSteps,
                                                        fullSolution = fullSolution,
                                                        mindMap = mindMap,
                                                        suggestedQuestions = suggestedQuestions
                                                )
                                        _statusText.value = "鐟欙絿鐡熺�瑰本鍨�"
                                    }
                                    "error" ->
                                            _statusText.value = "闁挎瑨顕�: ${json.optString("content")}"
                                }
                            } catch (e: Exception) {
                                Log.e("MainViewModel", "鐟欙絾鐎絊SE娴滃�╂�㈡径杈�瑙�: $data", e)
                            }
                        }
                    }
                }
            }
            reader.close()
            response.close()
        } catch (e: Exception) {
            Log.e("MainViewModel", "SSE鏉╃偞甯存径杈�瑙�: ${e.message}", e)
            withContext(Dispatchers.Main) { _statusText.value = "SSE婢惰精瑙�: ${e.message}" }
        }
    }

    /** 閻�銊﹀煕缂佈呯敾閹绘劙妫� */
    fun askQuestion(question: String) {
        val currentState = _appState.value as? AppState.Solving ?: return
        _statusText.value = "濮濓絽婀�閼惧嘲褰囬崶鐐电摕..."

        viewModelScope.launch(Dispatchers.IO) {
            try {
                // 鐠嬪啰鏁� API 閼惧嘲褰囬崶鐐电摕
                val answer =
                        apiService.askQuestion(
                                sessionId = currentState.requestId,
                                question = question
                        )

                withContext(Dispatchers.Main) {
                    // 鐏忓棝妫剁粵鏃囨嫹閸旂姴鍩岀�电�呯樈娑�?
                    val updatedSolution =
                            currentState.fullSolution + "\n\n---\n\n**Q: $question**\n\n$answer"

                    _appState.value =
                            currentState.copy(
                                    fullSolution = updatedSolution,
                                    suggestedQuestions = emptyList() // 濞撳懘娅庡�歌尙鍋ｉ崙鑽ゆ畱闂傤噣顣�
                            )
                    _statusText.value = "瀹告彃娲栫粵"
                }
            } catch (e: Exception) {
                withContext(Dispatchers.Main) { _statusText.value = "閹绘劙妫舵径杈�瑙�: ${e.message}" }
            }
        }
    }

