@Composable
fun FingerCountHint(fingerCount: Int) {
    val hintText =
            when (fingerCount) {
                5 -> "閴�?閸楀啿鐨㈤幏宥囧弾鐟欙綁顣介敍宀冾嚞鐏忓棙澧滅粔璇茬磻..."
                4 -> "棣冩灈 閸楀啿鐨㈤悽鐔稿灇閸斻劎鏁鹃敍宀冾嚞鐏忓棙澧滅粔璇茬磻..."
                1 -> "閳芥繐绗� 閸楀啿鐨㈤惌銉ㄧ槕瀵ゆ湹鍑犻敍宀冾嚞鐏忓棙澧滅粔璇茬磻..."
                else -> "$fingerCount 閺嶈�勫�滈幐"
            }

    Text(
            text = hintText,
            color = Color(0xFF00FF00),
            fontSize = 24.sp,
            fontWeight = FontWeight.Bold,
            modifier =
                    Modifier.fillMaxWidth()
                            .background(Color(0xAA000000), RoundedCornerShape(8.dp))
                            .padding(16.dp),
            textAlign = TextAlign.Center
    )
}

