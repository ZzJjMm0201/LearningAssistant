        Column(modifier = Modifier.padding(16.dp)) {
            Text(
                    text = title,
                    color = color,
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
            )
            Spacer(modifier = Modifier.height(8.dp))
            MarkdownView(content = content, modifier = Modifier.fillMaxWidth())
        }
    }
}

