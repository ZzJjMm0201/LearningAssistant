# ==================== 学习助手服务端环境变量模板 ====================
# 使用方法：复制本文件为 .env（与 config.py 同目录的上一级，即项目根目录），
# 填入自己的密钥。不设置时使用 server/config.py 中的默认值。

# DeepSeek 大模型 API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 好未来题库 API 签名密钥
SEARCH_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PaddleOCR-VL API Token
OCR_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 签名密钥（建议改为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string
