# ==================== 学习助手 · 环境变量模板 ====================
# 用法：复制本文件为 .env（同目录），填入自己的密钥。
#   cp .env.example .env
#
# 优先级：真实环境变量 > .env 文件 > 代码内置默认值
# 注意：.env 含密钥，已被 .gitignore 排除，勿提交。

# ---------- 必填：鉴权 ----------
# JWT 签名密钥。缺失时网关拒绝启动（不允许用默认值兜底，否则任何人可伪造任意用户 token）
# 生成：openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# ---------- 网关监听 ----------
LISTEN_ADDR=0.0.0.0:8000
# Python AI 服务地址。只应监听本机，不要对外暴露
AI_SERVICE_URL=http://127.0.0.1:8001

# ---------- 大模型（OpenAI 兼容端点）----------
# 至少配一家。未配置的提供方会被自动跳过。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_DEFAULT_VISION=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://hunyuan.tencentcloudapi.com/v1

# ---------- OCR ----------
# paddle = PaddleOCR 双通道（公式更准、能返回文字块坐标，批注依赖它）
# qwen   = 视觉大模型（能理解图形排版）
OCR_DEFAULT_MODE=qwen
# 云端 PaddleOCR-VL API（不配则只用本地或视觉通道）
# 注意：不要再使用别人分享的实例 URL，随时会失效
OCR_API_URL=
OCR_TOKEN=
OCR_API_TIMEOUT=15
# 是否启用本地 PaddleOCR（体积大，需另装 paddleocr）
ENABLE_LOCAL_OCR=false

# ---------- 功能开关 ----------
# AI 动画
ENABLE_ANIMATION=true
# 题库搜题（外部服务，可能随时失效，默认关闭）
ENABLE_QUESTION_SEARCH=false

# ---------- 其它 ----------
MAX_UPLOAD_MB=32
LOG_LEVEL=info